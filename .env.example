# Copy to .env and fill in. Never commit .env.

# ---- Database ----
# SQLite file, resolved relative to packages/db/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# ---- Client mode ----
# People layer. twin points the same client code at the local twin servers.
# The eval and chaos runners force twin regardless of these values.
# twin | twilio | imessage (this Mac's Messages app; needs Full Disk Access and Automation permission)
MESSAGING_MODE=twin
# Optional override of ~/Library/Messages/chat.db for MESSAGING_MODE=imessage
IMESSAGE_CHAT_DB=
# twin | google
CALENDAR_MODE=twin
# The inventory layer (flights, hotels, reservations, check-in) is always twinned. There is no real mode.

# ---- Model (constraint extraction, market generation, opening prices, repair proposals) ----
# openrouter is the only provider wired so far
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OpenRouter model id
LLM_MODEL=anthropic/claude-sonnet-5

# ---- Twilio (MESSAGING_MODE=twilio) ----
TWILIO_ACCOUNT_SID=
# Either the account auth token, or an API key pair (Standard key, or Restricted with Messaging permissions)
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# E.164 sender. Must be a verified toll-free or 10DLC-registered number or US carriers filter it.
TWILIO_FROM_NUMBER=

# ---- Google Calendar (CALENDAR_MODE=google) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token for the organizer's account. Other members are added as attendees.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---- Splitwise ----
# API key from https://secure.splitwise.com/apps (register an app, then generate an API key).
# That account pays up front; each booked item is split among the people on it. Empty = skipped.
SPLITWISE_API_KEY=

# ---- Concorde board (pnpm web) ----
# Name of the Messages group chat on this Mac. Leave empty to run the group on the Messages twin.
IMESSAGE_GROUP=
# This Mac's own iMessage number, when that person is also a member (e.g. the organizer). Their group
# messages are stored as sent-by-me and are read as theirs unless they match something Concorde sent.
IMESSAGE_SELF_HANDLE=
# Organizer first. Name:+1phone:google-email, comma separated. Leave empty for four simulated members.
TRIP_MEMBERS=
WEB_PORT=4300

# ---- Twin servers ----
TWIN_INVENTORY_URL=http://127.0.0.1:4100
TWIN_TWILIO_URL=http://127.0.0.1:4101
TWIN_CALENDAR_URL=http://127.0.0.1:4102

# ---- Observability ----
# debug | info | warn | error
LOG_LEVEL=info
