# Copy to .env and fill in. Never commit .env.

# ---- Database ----
# SQLite file, resolved relative to packages/db/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# ---- Client mode ----
# People layer: real hits live Twilio/Discord/Google, twin hits the local twin servers.
# The eval and chaos runners force twin regardless of these values.
SMS_MODE=twin
DISCORD_MODE=twin
CALENDAR_MODE=twin
# The inventory layer (flights, hotels, reservations, check-in) is always twinned. There is no real mode.

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# Used for constraint extraction, market generation, opening prices and repair proposals
LLM_MODEL=claude-sonnet-5

# ---- Twilio (SMS_MODE=real) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender. Must be a verified toll-free or 10DLC-registered number or US carriers filter it.
TWILIO_FROM_NUMBER=
# Public base URL Twilio posts inbound replies to, e.g. an ngrok tunnel to apps/web
TWILIO_WEBHOOK_BASE_URL=

# ---- Discord (DISCORD_MODE=real) ----
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Channel where markets, bets, resolutions and the leaderboard are posted
DISCORD_MARKETS_CHANNEL_ID=
# Channel for plan updates and disruption broadcasts
DISCORD_TRIP_CHANNEL_ID=

# ---- Google Calendar (CALENDAR_MODE=real) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token for the organizer's account. Other members are added as attendees.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---- Twin servers ----
TWIN_INVENTORY_URL=http://localhost:4100
TWIN_SMS_URL=http://localhost:4101
TWIN_DISCORD_URL=http://localhost:4102
TWIN_CALENDAR_URL=http://localhost:4103

# ---- Observability ----
# debug | info | warn | error
LOG_LEVEL=info
